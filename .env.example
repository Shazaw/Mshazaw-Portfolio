# Secret used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite database location (libsql URL). Relative paths resolve from the repo root.
# For Turso, set DATABASE_URI to libsql://... and provide DATABASE_AUTH_TOKEN.
DATABASE_URI=file:./data/holo-grid.db
# DATABASE_AUTH_TOKEN=

# Set on Vercel (or in the local shell while seeding the remote database).
# If absent, Payload uses local public/media storage instead.
# BLOB_READ_WRITE_TOKEN=

# Optional local/custom origin. Vercel can provide its production URL automatically.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: seed credentials for the first admin user created by `npm run seed`
SEED_ADMIN_EMAIL=ahsan.wiryawan@gmail.com
SEED_ADMIN_PASSWORD=change-me
